{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "linker",
    "main": "src/index.ts",
    "workers_dev": true,
    "compatibility_date": "2025-05-01",
    "compatibility_flags": ["nodejs_compat"],
    "placement": {
        // Use one of the following options (mutually exclusive):
        "mode": "smart",
    },
    "observability": {
        "logs": {
            "enabled": true,
            "invocation_logs": true,
        },
        "traces": {
            "enabled": true,
        },
    },
    // Two routes: admin host (custom_domain) + apex-level wildcard (shares).
    // Depth-1 wildcard (*.habitsofmind.com.au) is covered by free Universal SSL.
    // Wildcard route MUST be set to "Fail open (proceed)" in the CF dashboard so
    // unknown subs (www, info, autodiscover, …) bypass the worker to their own DNS.
    "routes": [
        {
            "pattern": "linker.habitsofmind.com.au",
            "custom_domain": true,
        },
        {
            "pattern": "*.habitsofmind.com.au/*",
            "zone_name": "habitsofmind.com.au",
        },
    ],
    // Static assets served from /public — Tailwind output, HTMX optional self-host.
    // Worker intercepts first; we explicitly call env.ASSETS.fetch when needed.
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
    },
    "r2_buckets": [
        {
            "binding": "BUCKET",
            "bucket_name": "habits-linker-content",
        },
    ],
    "kv_namespaces": [
        {
            "binding": "LINKS",
            "id": "16e3c69ab89c47d2ac4a5cc9daa8fa71",
            "remote": true,
        },
        {
            "binding": "THROTTLE",
            "id": "1de7e8129c654d1caa673527a180ef70",
            "remote": true,
        },
    ],
    "vars": {
        "SHARE_DOMAIN": "habitsofmind.com.au",
        "ADMIN_HOST": "linker.habitsofmind.com.au",
        "TURNSTILE_SITE_KEY": "0x4AAAAAADKIGS8sR36T2rtx",
    },
    // Secrets (set via `wrangler secret put`):
    //   ADMIN_PASSWORD
    //   COOKIE_HMAC_SECRET
    //   TURNSTILE_SECRET_KEY
}
