{
  "name": "habits-linker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n cf,css -c blue,magenta \"wrangler dev --remote\" \"pnpm tailwind:watch\"",
    "dev:worker": "wrangler dev --remote",
    "tailwind": "tailwindcss -i ./input.css -o ./public/style.css --minify",
    "tailwind:watch": "tailwindcss -i ./input.css -o ./public/style.css --watch",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm tailwind && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "@tailwindcss/cli": "^4.0.0",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
