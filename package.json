{
    "name": "habits-linker",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.16.0",
    "scripts": {
        "dev": "concurrently -n cf,css -c blue,magenta \"wrangler dev --remote\" \"pnpm tailwind:watch\"",
        "dev:worker": "wrangler dev --remote",
        "tailwind": "tailwindcss -i ./input.css -o ./public/style.css --minify",
        "tailwind:watch": "tailwindcss -i ./input.css -o ./public/style.css --watch",
        "build": "pnpm tailwind",
        "lint": "oxlint --type-aware --type-check src",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "deploy": "pnpm build && wrangler deploy",
        "cf-typegen": "wrangler types",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "client-zip": "^2.5.0",
        "hono": "^4.12.31",
        "nanoid": "^6.0.0",
        "qrcode": "^1.5.4"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "^0.18.7",
        "@cloudflare/workers-types": "^5.20260722.1",
        "@tailwindcss/cli": "^4.3.3",
        "@types/qrcode": "^1.5.6",
        "concurrently": "^10.0.3",
        "oxfmt": "^0.60.0",
        "oxlint": "^1.75.0",
        "oxlint-tsgolint": "^7.0.2001",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vitest": "~4.1.10",
        "wrangler": "^4.113.0"
    }
}
